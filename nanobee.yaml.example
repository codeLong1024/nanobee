# Nanobee 配置文件示例
# 复制此文件为 nanobee.yaml 并填入你的 API 密钥

# 数据目录（所有运行时数据的根目录，包括用户上下文、记忆、cron 任务等）
# 相对路径基于配置文件所在目录解析
# 实例级技能自动从 <data_dir>/skills/ 加载（管理员在此配属共享技能）
data_dir: "~/.nanobee"

# 网关配置（端口与多实例运行时管理）
# gateway:
#   port: 8080
#   # SIGTERM 后等待超时秒数
#   stop_timeout: 20.0
#   # 健康检查总超时秒数
#   health_check_timeout: 10.0
#   # 健康检查轮询间隔秒数
#   health_check_interval: 1.0
#   # PID 文件目录，空则自动推导为 <data_dir>/.pid/
#   pid_dir: ""
#   # restart 时 stop 与 start 之间的等待秒数
#   restart_delay: 2.0

agents:
  defaults:
    # 模型名称，格式：provider/model-name
    model: "anthropic/claude-sonnet-4-20250514"
    # 最大输出 token 数
    max_tokens: 8192
    # 上下文窗口大小
    context_window_tokens: 65536
    # 温度参数（0-1，越高越随机）
    temperature: 0.1
    # 记忆存储阈值（消息对数，超过此值时触发记忆提取与检索）
    # memory_store_threshold: 20
    # 最大对话循环次数（LLM 最多执行多少次思考-工具调用循环）
    # max_iterations: 10
    # 历史消息条数上限（超过此值×1.5 时压缩，回放时也受此限制）
    # max_messages: 120
    # 最大并发子代理数（超出时需等待已有子代理完成后才能创建新的）
    # max_concurrent_subagents: 4

# Provider 配置
providers:
  # Anthropic (Claude)
  anthropic:
    api_key: "sk-ant-your-api-key-here"
    # 可选：自定义 API 端点
    # api_base: "https://api.anthropic.com"

  # OpenAI 兼容接口（支持 GPT、本地模型等）
  # openai_compat:
  #   api_key: "your-api-key"
  #   api_base: "https://your-api-endpoint.com/v1"

  # OpenAI 官方
  # openai:
  #   api_key: "sk-your-openai-key"

  # 自定义 OpenAI 兼容端点
  # custom:
  #   api_key: "your-api-key"
  #   api_base: "http://localhost:8000/v1"

# MCP 服务器配置（可选）
# 连接 MCP 服务器并注册其工具、资源和提示
# mcp_servers:
#   # 示例：stdio 类型的 MCP 服务器
#   file-system:
#     type: "stdio"
#     command: "npx"
#     args: ["-y", "@modelcontextprotocol/server-filesystem", "/path/to/dir"]
#     # 可选：进程工作目录（默认回退到 data_dir，避免文件导出到 CWD）
#     # cwd: "/path/to/workdir"
#     # 可选：只启用特定工具
#     # enabled_tools: ["read_file", "write_file"]
#     # 工具调用超时时间（秒）
#     # tool_timeout: 30
#
#   # 示例：SSE 类型的 MCP 服务器
#   # remote-server:
#   #   type: "sse"
#   #   url: "http://localhost:3001/sse"
#   #   headers:
#   #     Authorization: "Bearer your-token"
#   #
#   # 示例：Streamable HTTP 类型的 MCP 服务器
#   # streamable-server:
#   #   type: "streamableHttp"
#   #   url: "http://localhost:3001/mcp"
#   #   headers:
#   #     X-API-Key: "your-api-key"

# 通道配置
# （实例级 enabled 控制：每个 Gateway 实例通过独立配置文件的
#  channels.<name>.enabled 控制加载的通道插件，实现实例隔离）
#
# 示例：仅启用钉钉通道
#   channels:
#     channel_dingtalk:
#       enabled: true
#       client_id: "dingxxx"
#       client_secret: "xxx"
#     channel_http:
#       enabled: false
#
# 示例：仅启用 HTTP API 通道
#   channels:
#     channel_dingtalk:
#       enabled: false
#     channel_http:
#       enabled: true
#       host: "127.0.0.1"
#       port: 8080
#
channels:
  channel_dingtalk:
    enabled: true
    # 消息标题（Markdown 消息的标题字段）
    # markdown_title: "AI助手回复"
    # client_id: "dingxxx"
    # client_secret: "xxx"
    # allow_from: ["*"]
    # streaming: true
  channel_http:
    enabled: false
    # 监听地址（默认 127.0.0.1，建议保持默认仅本地访问）
    # host: "127.0.0.1"
    # 监听端口（默认 8080）
    # port: 8080
    # API Key（可选，配置后在请求头中传递 Authorization: Bearer <key>）
    # api_key: "sk-your-http-api-key"
  channel_cli:
    enabled: true

# 路由配置（多租户映射）
# 格式："{channel}:{chat_id}" → user_id
# routing:
#   "cli:default": "user-alice"
#   "http:chat-123": "user-bob"

# 技能配置 —— 部署方声明哪些实例技能需要注入提示词
# 三级技能机制（框架提供，部署方声明）：
#   - 内置技能（nanobee/skills/）：框架打包，始终注入
#   - 实例技能（<data_dir>/skills/）：管理员配属，由 enabled 列表控制
#   - 用户技能（<context_root>/skills/）：用户自主管理，始终注入
# 
# enabled 为空列表时，所有实例技能自动注入（向后兼容）。
# enabled 非空时，仅注入列表中指定的技能，同时对应目录加入：
#   - 沙箱只读白名单（LLM 可通过 read_file 读取）
#   - bwrap 进程沙箱（LLM 可通过 execute_shell 执行脚本）
#
# 示例：仅启用 company-risk-scanner
# skills:
#   enabled:
#     - company-risk-scanner
#     - daily-report

# 安全配置
# tools:
#   # SSRF 白名单 CIDR（可选）：允许访问的私有/内网 CIDR 范围
#   # 例如：Tailscale 用户可添加 "100.64.0.0/10"
#   # 格式：CIDR 字符串列表
#   ssrfWhitelist:
#     - "100.64.0.0/10"

# 日志配置（程序自管理，loguru 文件 sink）
# 不配 file 字段（或注释掉）则不写文件，仅输出 stderr
# logging:
#   # 日志目录（相对路径基于进程 CWD，建议用绝对路径）
#   dir: "logs"
#   # 日志文件名（支持 {instance} 占位符，多实例时替换为实例名）
#   file: "gateway.log"
#   # 日志级别
#   level: "INFO"
#   # 轮转方式："500 MB" / "1 day" / "00:00"（每日午夜）
#   rotation: "500 MB"
#   # 保留天数
#   retention: "30 days"
#   # 是否压缩历史文件
#   compression: "gz"
#   # 生产环境建议开启 JSON 格式（便于 Promtail/Filebeat 采集）
#   json_format: false

# 插件配置
# plugins:
#   tool_shell:
#     # 沙箱后端（子进程隔离，需要系统安装 bwrap）
#     # sandbox: "bwrap"
    #     # 额外只读挂载（source:target 格式，可选）
    #     # 部署方声明需要映射到沙箱内的目录，如 venv site-packages 或 SDK 目录。
    #     # 注意：必须整条挂载（如整个 .venv），bwrap 不支持在 --ro-bind 创建的
    #     # 只读挂载点内部 mkdir 子挂载点，分拆子目录会导致所有命令失败。
    #     # extra_mounts:
    #     #   - "/home/user/.venv:/sandbox_venv"
    #     #
    #     # 沙箱内环境变量注入（可选，与 extra_mounts 配合使用）
    #     # env:
    #     #   PYTHONPATH: "/sandbox_venv/lib/python3.11/site-packages"
    #     #   PATH: "/sandbox_venv/bin:$PATH"
