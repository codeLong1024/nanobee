# Nanobee 配置文件示例
# 复制此文件为 nanobee.yaml 并填入你的 API 密钥

# 插件目录（相对于工作目录，建议使用绝对路径或相对于 ~/.nanobee 的路径）
# 内置插件会自动加载，无需手动配置
# plugin_dirs:
#   - ~/.nanobee/plugins

agents:
  defaults:
    # 模型名称，格式：provider/model-name
    model: "anthropic/claude-sonnet-4-20250514"
    # 最大输出 token 数
    max_tokens: 8192
    # 上下文窗口大小
    context_window_tokens: 65536
    # 温度参数（0-1，越高越随机）
    temperature: 0.1
    # 记忆存储阈值（消息对数，超过此值时触发记忆提取与检索）
    # memory_store_threshold: 20
    # 最大对话循环次数（LLM 最多执行多少次思考-工具调用循环）
    # max_iterations: 10
    # 历史消息条数上限（超过此值×1.5 时压缩，回放时也受此限制）
    # max_messages: 120

# Provider 配置
providers:
  # Anthropic (Claude)
  anthropic:
    api_key: "sk-ant-your-api-key-here"
    # 可选：自定义 API 端点
    # api_base: "https://api.anthropic.com"

  # OpenAI 兼容接口（支持 GPT、本地模型等）
  # openai_compat:
  #   api_key: "your-api-key"
  #   api_base: "https://your-api-endpoint.com/v1"

  # OpenAI 官方
  # openai:
  #   api_key: "sk-your-openai-key"

  # 自定义 OpenAI 兼容端点
  # custom:
  #   api_key: "your-api-key"
  #   api_base: "http://localhost:8000/v1"

# MCP 服务器配置（可选）
# 连接 MCP 服务器并注册其工具、资源和提示
# mcp_servers:
#   # 示例：stdio 类型的 MCP 服务器
#   file-system:
#     type: "stdio"
#     command: "npx"
#     args: ["-y", "@modelcontextprotocol/server-filesystem", "/path/to/dir"]
#     # 可选：只启用特定工具
#     # enabled_tools: ["read_file", "write_file"]
#     # 工具调用超时时间（秒）
#     # tool_timeout: 30
#
#   # 示例：SSE 类型的 MCP 服务器
#   # remote-server:
#   #   type: "sse"
#   #   url: "http://localhost:3001/sse"
#   #   headers:
#   #     Authorization: "Bearer your-token"
#   #
#   # 示例：Streamable HTTP 类型的 MCP 服务器
#   # streamable-server:
#   #   type: "streamableHttp"
#   #   url: "http://localhost:3001/mcp"
#   #   headers:
#   #     X-API-Key: "your-api-key"

# 插件配置
# （实例级 enabled 控制：每个 Gateway 实例通过独立配置文件的
#  plugins.<name>.enabled 控制加载的插件组合，实现实例隔离）
#
# 示例：基础版实例（仅文件操作 + 消息通道）
#   plugins:
#     tool_shell: { enabled: false }
#     tool_web:   { enabled: false }
#     tool_cron:  { enabled: false }
#
# 示例：完整版实例（全功能）
#   plugins:
#     tool_shell: { sandbox: "bwrap" }
#
# plugins:
#   tool_shell:
#     # 启用/禁用插件（默认 true）
#     # enabled: false
#     # 进程级沙箱后端（默认 "" = 不启用）
#     # "bwrap" — 使用 bubblewrap 的 mount namespace 隔离子进程
#     # 需要系统安装 bwrap（apt install bubblewrap）
#     # 注意：启用后子进程只能访问 workspace 目录，不能通过 /proc/self/root 绕过
#     sandbox: "bwrap"
#   channel_http:
#     # 监听地址（默认 127.0.0.1，建议保持默认仅本地访问）
#     host: "127.0.0.1"
#     # 监听端口（默认 8080）
#     port: 8080
#     # API Key（可选，配置后在请求头中传递 Authorization: Bearer <key>）
#     # api_key: "sk-your-http-api-key"
#   dingtalk:
#     # 钉钉文档 MCP 服务器 URL（对应环境变量 DINGTALK_DOC_SERVER_URL）
#     # doc_server_url: "https://mcp-gw.dingtalk.com/..."
#     # 钉钉多维表 MCP 服务器 URL（对应环境变量 DINGTALK_AITABLE_SERVER_URL）
#     # aitable_server_url: "https://mcp-gw.dingtalk.com/..."
#     # 默认目标文件夹 ID（创建文档/多维表时未指定 folder_id 时使用）
#     # folder_id: "kDnRL6jAJM3jqBKRIXX2YxadWyMoPYe1"
#     # MCP API Key（可选）
#     # api_key: "your-api-key"

# 路由配置（多租户映射）
# 格式："{channel}:{chat_id}" → user_id
# routing:
#   "cli:default": "user-alice"
#   "http:chat-123": "user-bob"

# 安全配置
# tools:
#   # SSRF 白名单 CIDR（可选）：允许访问的私有/内网 CIDR 范围
#   # 例如：Tailscale 用户可添加 "100.64.0.0/10"
#   # 格式：CIDR 字符串列表
#   ssrfWhitelist:
#     - "100.64.0.0/10"
